# 同在 · 独立版运行配置
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# 默认部署到根路径。子路径示例：/tongzai
# 构建 npm run build 与运行 npm start 必须使用同一个值。
APP_BASE_PATH=

# 可选：自己选用的 STUN 地址，多个地址用逗号分隔。
# 示例：stun:voice.example.com:3478
STUN_URLS=

# 可选：coturn 中继。这里的共享密钥必须与 coturn static-auth-secret 一致。
# 示例：turn:voice.example.com:3478?transport=udp,turn:voice.example.com:3478?transport=tcp
TURN_URL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=7200

# all：自动选择可用路径；relay：仅通过中继尝试连接。
ICE_TRANSPORT_POLICY=all

# 可选：三项都配置后使用 LiveKit。密钥只供服务端读取。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
