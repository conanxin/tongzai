{
  "name": "tongzai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "同在 · 双人互动空间：对话、共读和排练，支持单机自托管。",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build --config vite.client.config.ts && node --env-file-if-exists=.env node_modules/vite/bin/vite.js build --config vite.server.config.ts",
    "start": "node --env-file-if-exists=.env standalone/server/index.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/server-state.test.ts tests/node-server.test.mjs tests/voice-diagnostics.test.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "livekit-client": "2.24.1",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
